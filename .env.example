NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/complete_crm

# Generate a long random value and never commit the real secret.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=complete-crm-api
JWT_AUDIENCE=complete-crm-client

CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10

# SMTP is optional in development; messages use a local JSON transport if omitted.
EMAIL_FROM=Complete CRM <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Adapt services/smsService.js to the payload expected by your provider.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
