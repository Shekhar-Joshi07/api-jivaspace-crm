{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api-jivaspace-crm",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-07-03",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api-crm.jivaspace.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "MONGO_URI",
      "JWT_SECRET"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_URL": "https://crm.jivaspace.com,http://localhost:5173,http://127.0.0.1:5173",
    "JWT_EXPIRES_IN": "7d",
    "JWT_ISSUER": "complete-crm-api",
    "JWT_AUDIENCE": "complete-crm-client",
    "MAX_FILE_SIZE_MB": "10",
    "MONGO_SERVER_SELECTION_TIMEOUT_MS": "10000"
  }
}
